{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "noEmit": false,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "types": []
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "src/**/*.test.*",
    "src/**/*.spec.*",
    "src/**/tests/**/*",
    "src/__mocks__/**/*",
    "src/setupTest.*",
    "src/app.ts",
    "src/slots.tsx",
    "src/i18n/**/*",
    "src/Notification/test-harness.tsx"
  ]
}
